{
  "$schema": "https://opencode.ai/config.json",
  "model": "amazon-bedrock/us.anthropic.claude-opus-5-5",
  "permission": {
    "edit": "ask",
    "external_directory": {
      "*": "ask",
      "~/projects/aa/**": "allow",
    },
  },
  "plugin": [
    "opencode-wakatime"
  ],
  "mcp": {
    "servers": {
      "zoho": {
        "type": "remote",
        "url": "{env:ZOHO_MCP_URL}"
      }
    }
  },
}
