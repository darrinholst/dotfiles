#!/usr/bin/env python3
"""Clone NUL-delimited src/dst pairs from stdin using APFS clonefile(2)."""

import ctypes
import ctypes.util
import os
import subprocess
import sys

_lib = ctypes.CDLL(ctypes.util.find_library("System"), use_errno=True)
_lib.clonefile.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_int]


def clone(src, dst):
    if _lib.clonefile(src.encode(), dst.encode(), 0) == 0:
        return True
    errno = ctypes.get_errno()
    print(
        f"{os.path.basename(sys.argv[0])}: clonefile {src}: {os.strerror(errno)}, falling back",
        file=sys.stderr,
    )
    return subprocess.call(["cp", "-R", src, dst]) == 0


def main():
    fields = sys.stdin.buffer.read().split(b"\0")
    pairs = [f.decode() for f in fields if f]

    if len(pairs) % 2:
        print("usage: wt-clone < src\\0dst\\0...", file=sys.stderr)
        return 64

    failed = 0
    for src, dst in zip(pairs[::2], pairs[1::2]):
        if os.path.exists(dst):
            continue
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        if not clone(src, dst):
            failed += 1

    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
