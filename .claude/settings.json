{
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); cwd=$(echo \"$input\" | jq -r '.workspace.current_dir'); model=$(echo \"$input\" | jq -r '.model.display_name'); remaining=$(echo \"$input\" | jq -r '.context_window.remaining_percentage // empty'); git_branch=$(cd \"$cwd\" 2>/dev/null && git -c core.fileMode=false config --global --add safe.directory \"$cwd\" 2>/dev/null; git -c core.fileMode=false rev-parse --abbrev-ref HEAD 2>/dev/null); [ -n \"$git_branch\" ] && git_info=\" on $git_branch\" || git_info=\"\"; [ -n \"$remaining\" ] && ctx_info=\" [ctx: ${remaining}%]\" || ctx_info=\"\"; printf \"\\033[2m%s in %s%s%s\\033[0m\" \"$model\" \"$cwd\" \"$git_info\" \"$ctx_info\""
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true,
    "claude-code-wakatime@wakatime": true
  },
  "extraKnownMarketplaces": {
    "wakatime": {
      "source": {
        "source": "git",
        "url": "https://github.com/wakatime/claude-code-wakatime.git"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "permissions": {
    "additionalDirectories": [
      "~/projects/aa"
    ]
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "promptSuggestionEnabled": false,
  "terminalProgressBarEnabled": false,
  "tui": "fullscreen",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.bin/tmux-agent-state clear >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.bin/tmux-agent-state waiting >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.bin/tmux-agent-state done >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.bin/tmux-agent-state clear >/dev/null 2>&1 || true"
          }
        ]
      }
    ]
  }
}
